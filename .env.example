# App
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
HTTP_TRUST_ENV=false

# Channel selection
CLIENT_CHANNELS=max

# Telegram fallback (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
ADMIN_TELEGRAM_CHAT_ID=

# MAX
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api.max.ru
# polling works immediately on a server; webhook is recommended for strict production with HTTPS/443.
MAX_MODE=polling
MAX_WEBHOOK_ENABLED=false
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_HOST=0.0.0.0
MAX_WEBHOOK_PORT=8080
MAX_WEBHOOK_PATH=/webhooks/max
MAX_POLL_429_SLEEP_SECONDS=60
MAX_POLL_ERROR_SLEEP_SECONDS=10
MAX_ADMIN_CHAT_ID=
MAX_ADMIN_USER_ID=
MAX_MEDIA_ENABLED=true
MAX_MESSAGE_FORMAT=markdown

# LLM
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PARSER_MODEL=openai/gpt-4o-mini
ANSWER_MODEL=openai/gpt-4o
ANSWER_FALLBACK_MODEL=openai/gpt-4o-mini
PARSER_MAX_TOKENS=700
ANSWER_MAX_TOKENS=1600
FINALIZER_MAX_TOKENS=1200
MEDIA_MAX_TOKENS=400
OPENAI_MAX_TOKENS=700
OPENAI_TEMPERATURE=0.2
LLM_MAX_RETRIES=1
LLM_REQUEST_TIMEOUT_SECONDS=0
LLM_RETRY_BASE_SECONDS=0
LLM_RETRY_MAX_SECONDS=0

# YClients
YCLIENTS_BASE_URL=https://api.yclients.com/api/v1
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_USER_TOKEN=
YCLIENTS_COMPANY_ID=
YCLIENTS_SYNC_ENABLED=true
YCLIENTS_SYNC_DAYS_BACK=1
YCLIENTS_SYNC_DAYS_FORWARD=180
YCLIENTS_SYNC_INTERVAL_SECONDS=300

# Payments
PAYMENT_PROVIDER=yookassa
PAYMENT_SHOP_ID=
PAYMENT_SECRET_KEY=
PAYMENT_SUCCESS_URL=
PAYMENT_FAIL_URL=
PREPAYMENT_AMOUNT_RUB=1
PAYMENT_STATUS_LOOP_ENABLED=true
PAYMENT_STATUS_SYNC_INTERVAL_SECONDS=10

# Postgres / Supabase
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_SSL_MODE=require
DB_SSLROOTCERT=~/.postgresql/root.crt
DB_TARGET_SESSION_ATTRS=
DB_CONNECT_TIMEOUT=12

# Runtime
HOLD_TTL_MINUTES=10
WATCHLIST_LOOP_ENABLED=true
WATCHLIST_LOOP_INTERVAL_SECONDS=30
STARTUP_AVAILABILITY_REFRESH_ENABLED=false
STARTUP_AVAILABILITY_REFRESH_DELAY_SECONDS=180
SQLITE_PATH=bot.sqlite3

# Editable non-secret business profile
ADMIN_PROFILE_PATH=business_profile/admin_profile.yaml

# Automatic retention cleanup
# Disabled by default. Enable only after read-only report and dry-run are reviewed for the target DB.
RETENTION_CLEANUP_ENABLED=false
RETENTION_CLEANUP_DRY_RUN=false
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
RETENTION_CLEANUP_STARTUP_DELAY_SECONDS=300
RETENTION_CLEANUP_MAX_ROWS=1000
RETENTION_CLEANUP_INCLUDE_FILES=true
# Use "all" for every guarded apply operation. The default protects bookings and active client intent.
RETENTION_CLEANUP_ONLY=old_messages,old_inactive_conversations,old_system_logs,old_inactive_slot_holds,active_holds_past_expiry,old_sent_admin_notifications,stale_availability_cache,past_availability_cache_dates,old_inactive_watchlist,old_voice_temp_files
RETENTION_MESSAGES_DAYS=90
RETENTION_SYSTEM_LOGS_DAYS=30
RETENTION_HOLDS_DAYS=1
RETENTION_ADMIN_NOTIFICATIONS_DAYS=30
RETENTION_AVAILABILITY_CACHE_DAYS=7
RETENTION_WATCHLIST_DAYS=30
RETENTION_VOICE_TEMP_DAYS=1
RETENTION_BOOKING_REVIEW_DAYS=180

# LLM token optimization
LLM_HISTORY_LIMIT=6
LLM_AVAILABILITY_LIMIT=120
LLM_OBJECT_DATES_LIMIT=14
LLM_AVAILABILITY_MAX_CHARS=8000
LLM_KNOWLEDGE_MAX_CHARS=8000
LLM_MEDIA_DECISION_ENABLED=true
LLM_MEDIA_AVAILABILITY_MAX_CHARS=2500
PARSER_MAX_TOKENS=350
ANSWER_MAX_TOKENS=700
FINALIZER_MAX_TOKENS=500
MEDIA_MAX_TOKENS=120
OPENAI_MAX_TOKENS=500
# Cheapest stable mode for this bot. Set ANSWER_MODEL=openai/gpt-4o only if quality drops.
# ANSWER_MODEL=openai/gpt-4o-mini

# MAX admin notifications
# Do not put a random profile/user id here. In MAX, send `/admin` to the bot and use chat_id from the reply.
# Or set MAX_ADMIN_SECRET and send `/admin <secret>` to bind the admin chat automatically.
MAX_ADMIN_SECRET=
MAX_ADMIN_CHAT_ID=
MAX_ADMIN_USER_ID=
MAX_ADMIN_ERROR_SLEEP_SECONDS=60

# Voice messages / transcription
VOICE_MESSAGES_ENABLED=true
# For OpenRouter-compatible mode, set base URL and key explicitly if your selected provider supports /audio/transcriptions:
# VOICE_TRANSCRIPTION_BASE_URL=https://openrouter.ai/api/v1
# VOICE_TRANSCRIPTION_API_KEY=sk-or-...
# VOICE_TRANSCRIPTION_MODEL=openai/whisper-1
# For OpenAI direct fallback:
# VOICE_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# VOICE_TRANSCRIPTION_MODEL=whisper-1
VOICE_TRANSCRIPTION_BASE_URL=
VOICE_TRANSCRIPTION_API_KEY=
VOICE_TRANSCRIPTION_MODEL=whisper-1
VOICE_TRANSCRIPTION_LANGUAGE=ru
VOICE_TRANSCRIPTION_RESPONSE_FORMAT=json
VOICE_MAX_DOWNLOAD_MB=25
